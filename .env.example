# Plantilla de variables de entorno. Copia este archivo como ".env" y completa los valores.
# NO subas el archivo ".env" al repositorio (ya está en .gitignore).

# ---------- Frontend (Vite) ----------
# URL base de la API. En local apunta al backend; en producción, a la URL pública.
VITE_API_URL=http://localhost:8080
# Solo para la variante de microservicios (services/). Déjalas vacías con el backend único.
VITE_AUTH_API_URL=
VITE_PRODUCT_API_URL=
VITE_USER_API_URL=

# ---------- Backend (referencia para Docker / ejecución local) ----------
DB_URL=jdbc:postgresql://localhost:5432/levelup
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_clave
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JPA_DDL_AUTO=update
